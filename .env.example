# ============================================================
# 知问 ZhiWen 密钥配置模板
# 使用方式：复制本文件为 .env 并填入真实密钥
#   （Windows:  copy .env.example .env ;  Linux/macOS: cp .env.example .env）
# 注意：.env 已被 .gitignore 排除，绝不会被提交到 GitHub；
#       日志中密钥自动脱敏，只显示前 4 位。
# ============================================================

# ---- DeepSeek 对话 API（api profile 的 LLM，需充值，约 20-50 元够开发调试数月）----
# 注册：https://platform.deepseek.com
DEEPSEEK_API_KEY=

# ---- SiliconFlow（免费 embedding 与免费 reranker，api profile 的检索增强侧）----
# 注册即送额度：https://siliconflow.cn  ->  模型广场搜 BAAI/bge-m3（免费）
SILICONFLOW_API_KEY=

# ---- 本地 Ollama（local profile 使用，无需密钥；未安装可留空）----
# 安装：https://ollama.com ，然后执行  ollama pull qwen3:8b
OLLAMA_BASE_URL=http://localhost:11434/v1
