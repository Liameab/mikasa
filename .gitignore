# ===== Python =====
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# ===== 测试与工具缓存 =====
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
# 评审/调试用的临时目录（本会话留下的 .tmp-e2e / .tmp-pytest / .tmp-iss 等；
# 都是 scratch，别让 `git add -A` 顺手收进来）
.tmp-*/

# ===== 密钥与本地环境（绝不入库） =====
.env
.env.*
!.env.example

# ===== 运行产物（数据目录即全部状态，备份=复制 data/） =====
data/
*.db
*.db-wal
*.db-shm

# ===== 个人数据（绝不入库：每个使用者只该有自己的那份） =====
# 注意：.gitignore **不支持行尾注释**——模式后跟 "# 说明" 会让整行失效，
# 注释必须独立成行（2026-09-11 实测踩坑：下面几条一度全部没生效）

# 文档源文件备份（重灌前的保险，含私人资料）
backup_uploads/
# 注：evals/golden_set.json **随仓库发布**——它是 sample-corpus 的配套
# 黄金集（不是本机产物）：谁灌入同一份 sample-corpus 都会得到相同的语料
# 指纹，clone 后可直接跑评测；改了 sample-corpus 记得重跑 build_golden。
# Ollama 以相对路径启动时的残留目录
ollamamodels/

# ===== 内部工作文档（不进公开仓库） =====
# 项目私人总账：含个人进度、待办与协作记录，非项目文档
docs/ideas-and-backlog.md

# ===== 本地工具产物与配置 =====
# 无头 Chrome 验收截图
tools/shots/
# 本地 AI 工具配置
.claude/
# 桌面快捷方式（含本机绝对路径，对他人无意义）
Mikasa.lnk

